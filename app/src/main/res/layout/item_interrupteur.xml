<?xml version="1.0" encoding="utf-8"?>
<!-- Une "carte" pour un interrupteur : nom, deux boutons, statut, et un lien pour le supprimer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/fond_carte"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/texteNomIp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/texteEtat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:saveEnabled="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boutonAllumer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Allumer"
            android:textAllCaps="false"
            app:backgroundTint="@color/boutonAllumer"
            app:cornerRadius="24dp" />

        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boutonEteindre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Éteindre"
            android:textAllCaps="false"
            app:backgroundTint="@color/boutonEteindre"
            app:cornerRadius="24dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/texteStatut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:textColor="#666666"
        android:saveEnabled="false" />

    <TextView
        android:id="@+id/boutonSupprimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:padding="4dp"
        android:text="Supprimer"
        android:textColor="#999999"
        android:textSize="12sp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
