<?xml version="1.0" encoding="utf-8"?>
<!--
    Silhouette stylisee d'un chateau (tours pointues, creneaux, porte, fenetres) :
    dessinee a la main dans une grille 24x24, puis centree/agrandie dans le
    canevas 108x108 attendu par une icone adaptative.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="24"
        android:translateY="25">
        <group
            android:scaleX="2.5"
            android:scaleY="2.5">
            <!-- Corps du chateau : mur crenele + deux tours a toit pointu -->
            <path
                android:fillColor="#F2E9DC"
                android:pathData="
                    M6,21 L6,12 L18,12 L18,21 Z
                    M6,12 L6,10 L8,10 L8,12 Z
                    M10,12 L10,10 L12,10 L12,12 Z
                    M14,12 L14,10 L16,10 L16,12 Z
                    M2,21 L2,8 L8,8 L8,21 Z
                    M1,8 L5,2 L9,8 Z
                    M16,21 L16,8 L22,8 L22,21 Z
                    M15,8 L19,2 L23,8 Z" />
            <!-- Porte et fenetres, en fonce, par-dessus la silhouette -->
            <path
                android:fillColor="#5B4636"
                android:pathData="
                    M10.5,21 L10.5,16 L13.5,16 L13.5,21 Z
                    M4,14 L4,16 L6,16 L6,14 Z
                    M18,14 L18,16 L20,16 L20,14 Z" />
        </group>
    </group>
</vector>
